include LICENSE THIRD_PARTY_NOTICES.md README.md CONTRIBUTING.md CHANGELOG.md pyproject.toml
include requirements-m0.txt requirements-build.txt
recursive-include src/colorpipe *.py
recursive-include docs *.md
recursive-include tests *.py
include tests/fixtures.example.json
recursive-include tools *.py
recursive-include .github/workflows *.yml
prune out
prune build
prune dist
prune .venv
prune .cache
prune fixtures
global-exclude __pycache__ *.py[cod] *.orf *.ORF *.ori *.ORI *.dng *.DNG *.dcp *.DCP
